<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns="http://schemas.wps.cn/oaassist/2019/manifest"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <id>opencode-wps-assistant</id>
    <version>1.0.0</version>
    <name>OpenCode AI</name>
    <description>OpenCode AI 与 WPS Office 桥接加载项（反向轮询模式）</description>
    <author>OpenCode Team</author>

    <hosts>
        <host name="wps"/>
        <host name="et"/>
        <host name="wpp"/>
    </hosts>

    <permissions>
        <permission name="document.read"/>
        <permission name="document.write"/>
    </permissions>

    <ribbon src="ribbon.xml"/>

    <scripts>
        <script src="utils/response.js"/>
        <script src="handlers/registry.js"/>
        <script src="handlers/common-handler.js"/>
        <script src="handlers/word-handler.js"/>
        <script src="handlers/excel-handler.js"/>
        <script src="handlers/ppt-handler.js"/>
        <script src="main.js"/>
    </scripts>
</manifest>
